# Supabase project settings (Dashboard > Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: required only for privileged server-side account provisioning.
# Never expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Reserved for private student photo uploads if Vercel Blob is selected later.
BLOB_READ_WRITE_TOKEN=
